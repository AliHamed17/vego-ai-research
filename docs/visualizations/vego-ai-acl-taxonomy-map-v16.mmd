    class COMP,COOPET,COMPM,COOPETM notrel;
    class ORCH,COMM,DEL,HFI,HFHOL less;
    class ENVMAP,ENVHMAP,ENVAMAP,HFEM,HFCM,HFGM,HFIM,HFHOLM,HFSEGM,HFINIM,HFDURM,HFPOSTM,SUPM,DELM,COORDM,COOPM,SEQM,PARM,SYNCM,ASYNCM,CENTM,DECENTM,HIERM,CONVM,OBSM,POOLM sourceMap;
