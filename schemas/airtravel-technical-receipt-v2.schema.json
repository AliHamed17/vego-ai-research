{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirTravel v4 technical receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mode", "status", "reviewed_head",
    "packet_manifest_sha256", "request_sha256", "authorization_message_sha256",
    "grant_sha256", "command_sha256", "invocation_id", "nonce", "attempt_number",
    "started_at", "completed_at", "grant_valid_at_start", "timeout",
    "retry_count", "replay_count", "direct_fake_call_count",
    "instrumented_fake_call_count", "combined_fake_call_count", "call_count_equal",
    "prompt_parity", "answer_parity", "decision_parity",
    "pipeline_state_parity", "scientific_artifact_parity", "completed_cases",
    "completed_phases", "event_log_sha256", "event_count", "question_count",
    "answer_count", "termination_count", "termination_counts", "route_pairs",
    "protected_manifest_hash_before", "protected_manifest_hash_after",
    "tracked_manifest_hash_before", "tracked_manifest_hash_after",
    "output_inventory_sha256", "containment_status", "privacy_status",
    "call_record_hashes", "safety_counters", "grant_consumption_status"
  ],
  "properties": {
    "schema_version": {"const": "airtravel-technical-receipt-v2"},
    "mode": {"const": "execute"},
    "status": {"enum": ["TECHNICAL_SUCCESS", "TECHNICAL_FAILED"]},
    "reviewed_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "packet_manifest_sha256": {"$ref": "#/$defs/hash"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "authorization_message_sha256": {"$ref": "#/$defs/hash"},
    "grant_sha256": {"$ref": "#/$defs/hash"},
    "command_sha256": {"$ref": "#/$defs/hash"},
    "invocation_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "attempt_number": {"const": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "grant_valid_at_start": {"const": true},
    "timeout": {"type": "boolean"},
    "retry_count": {"const": 0},
    "replay_count": {"const": 0},
    "direct_fake_call_count": {"type": "integer", "minimum": 16, "maximum": 326},
    "instrumented_fake_call_count": {"type": "integer", "minimum": 16, "maximum": 326},
    "combined_fake_call_count": {"type": "integer", "minimum": 32, "maximum": 652},
    "call_count_equal": {"const": true},
    "prompt_parity": {"const": true},
    "answer_parity": {"const": true},
    "decision_parity": {"const": true},
    "pipeline_state_parity": {"const": true},
    "scientific_artifact_parity": {"const": true},
    "completed_cases": {"const": ["01", "02", "03", "04"]},
    "completed_phases": {"const": ["phase1", "phase2", "phase3", "phase4"]},
    "event_log_sha256": {"$ref": "#/$defs/hash"},
    "event_count": {"type": "integer", "minimum": 1},
    "question_count": {"type": "integer", "minimum": 1},
    "answer_count": {"type": "integer", "minimum": 1},
    "termination_count": {"type": "integer", "minimum": 1},
    "termination_counts": {"type": "object"},
    "route_pairs": {"type": "array"},
    "protected_manifest_hash_before": {"$ref": "#/$defs/hash"},
    "protected_manifest_hash_after": {"$ref": "#/$defs/hash"},
    "tracked_manifest_hash_before": {"$ref": "#/$defs/hash"},
    "tracked_manifest_hash_after": {"$ref": "#/$defs/hash"},
    "output_inventory_sha256": {"$ref": "#/$defs/hash"},
    "containment_status": {"const": "PASS"},
    "privacy_status": {"const": "PASS"},
    "call_record_hashes": {"type": "object", "minProperties": 2},
    "safety_counters": {"type": "object"},
    "grant_consumption_status": {"const": "CONSUMED"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
