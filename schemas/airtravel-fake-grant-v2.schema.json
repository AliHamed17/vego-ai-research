{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirTravel v4 owner grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "grant_type", "granted_by", "reviewed_head",
    "implementation_commit_ancestor", "packet_manifest_sha256",
    "authorization_message_sha256", "command_sha256", "run_root", "control_root",
    "output_root", "verification_root", "setting_id", "corpus_id", "N",
    "runtime_archive_sha256", "runtime_file_hashes", "command_template",
    "protected_manifest_path", "protected_manifest_sha256", "harness_code_hashes",
    "schema_hashes", "timeout_seconds",
    "minimum_calls_per_pass", "maximum_calls_per_pass", "maximum_invocations",
    "network_forbidden", "external_provider_calls_allowed",
    "paid_execution_authorized", "provider_execution_enabled", "detector_v1_forbidden", "renderer_forbidden",
    "allowed_write_roots", "prohibited_write_roots", "required_evidence_files",
    "granted_at", "expires_at", "expiry_condition"
  ],
  "properties": {
    "schema_version": {"const": "airtravel-fake-grant-v2"},
    "status": {"const": "GRANTED"},
    "grant_type": {"const": "OFFLINE_FAKE_PREFLIGHT_ONLY"},
    "granted_by": {"const": "Ali Hamed"},
    "reviewed_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "implementation_commit_ancestor": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "packet_manifest_sha256": {"$ref": "#/$defs/hash"},
    "authorization_message_sha256": {"$ref": "#/$defs/hash"},
    "command_sha256": {"$ref": "#/$defs/hash"},
    "run_root": {"const": "external_data/airtravel-pr38/v4-authorized-fake-run"},
    "control_root": {"const": "external_data/airtravel-pr38/v4-authorized-fake-run/control"},
    "output_root": {"const": "external_data/airtravel-pr38/v4-authorized-fake-run/output"},
    "verification_root": {"const": "external_data/airtravel-pr38/v4-authorized-fake-run/verification"},
    "setting_id": {"const": "cd_airtravel"},
    "corpus_id": {"const": "text2uml_airtravel_253b26dc"},
    "N": {"const": 4},
    "runtime_archive_sha256": {"$ref": "#/$defs/hash"},
    "runtime_file_hashes": {
      "type": "object", "minProperties": 5, "maxProperties": 5,
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "command_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protected_manifest_path": {"const": "docs/research/phd-proposal/airtravel-pr38-correction/protected-hashes.json"},
    "protected_manifest_sha256": {"$ref": "#/$defs/hash"},
    "harness_code_hashes": {"type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "schema_hashes": {"type": "object", "minProperties": 3, "maxProperties": 3, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "timeout_seconds": {"const": 1800},
    "minimum_calls_per_pass": {"const": 16},
    "maximum_calls_per_pass": {"const": 326},
    "maximum_invocations": {"const": 1},
    "network_forbidden": {"const": true},
    "external_provider_calls_allowed": {"const": 0},
    "paid_execution_authorized": {"const": false},
    "provider_execution_enabled": {"const": false},
    "detector_v1_forbidden": {"const": true},
    "renderer_forbidden": {"const": true},
    "allowed_write_roots": {"const": ["external_data/airtravel-pr38/v4-authorized-fake-run"]},
    "prohibited_write_roots": {"type": "array", "items": {"type": "string"}},
    "required_evidence_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "granted_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "expiry_condition": {"const": "ANY_BOUND_HASH_COMMIT_COMMAND_OR_PATH_CHANGE"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
