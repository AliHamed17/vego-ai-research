{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai.local/schemas/study2-result-v1.schema.json",
  "title": "VEGO-AI Study 2 condition result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_class", "condition", "run_id", "setting_id", "corpus_id", "corpus_hashes",
    "code_sha256", "configuration_sha256", "model", "control_policy", "objective_schema", "fixture_mode",
    "prompt_sha_by_case", "prompt_sha_by_call", "cases", "successful_cases", "technical_failures", "status", "failure_code",
    "agent_decomposition", "inter_agent_qa", "questions", "answers", "episodes",
    "detector_v1", "attempts", "attempt_markers", "calls", "successful_calls", "retries_used", "input_tokens",
    "output_tokens", "cost_usd", "elapsed_seconds", "privacy_counters", "provider_calls", "external_calls", "events",
    "lifecycle", "output_validation"
  ],
  "properties": {
    "schema_version": {"const": "study2-result-v1"},
    "evidence_class": {"const": "ENGINEERING_FIXTURE_ONLY"},
    "condition": {"enum": ["VEGO_AI_ON", "VEGO_AI_OFF"]},
    "run_id": {"type": "string", "minLength": 1},
    "setting_id": {"const": "cd_airtravel"},
    "corpus_id": {"const": "text2uml_airtravel_253b26dc"},
    "corpus_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "code_sha256": {"type": "string", "minLength": 1},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "object"},
    "control_policy": {"type": "object"},
    "objective_schema": {"const": "study2-result-v1"},
    "fixture_mode": {"enum": ["no_questions", "two_rounds", "max_rounds"]},
    "prompt_sha_by_case": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "prompt_sha_by_call": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "cases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "successful_cases": {"type": "integer", "minimum": 0},
    "technical_failures": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "TECHNICAL_FAILURE"]},
    "failure_code": {"type": ["string", "null"]},
    "agent_decomposition": {"type": "boolean"},
    "inter_agent_qa": {"type": "boolean"},
    "questions": {"type": "integer", "minimum": 0},
    "answers": {"type": "integer", "minimum": 0},
    "episodes": {"type": "integer", "minimum": 0},
    "events": {"type": "array", "items": {"type": "object"}},
    "detector_v1": {"type": "object"},
    "attempts": {"type": "integer", "minimum": 0},
    "attempt_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "attempt"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "attempt": {"type": "integer", "minimum": 1}
        }
      }
    },
    "calls": {"type": "integer", "minimum": 0},
    "successful_calls": {"type": "integer", "minimum": 0},
    "retries_used": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "privacy_counters": {"type": "object"},
    "provider_calls": {"const": 0},
    "external_calls": {"const": 0},
    "lifecycle": {"type": "object"},
    "output_validation": {"type": "object"}
  }
}
