{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai.example/schemas/pilot-repeat-receipt-v1.schema.json",
  "title": "Budget-constrained exploratory pilot repeat receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_class", "study_class", "run_id", "setting_id", "corpus_id",
    "model", "config_sha256", "code_sha256", "case_input_hashes", "prospective_binding_sha256",
    "event_log_sha256", "lifecycle_summary", "status", "failure_code", "calls",
    "successful_calls", "retry_count", "repeat_retry_count", "truncated_calls",
    "scientific_denominator_eligible", "input_tokens", "output_tokens", "cost_usd",
    "started_at", "completed_at", "provider_calls", "external_calls", "privacy_counters"
  ],
  "properties": {
    "schema_version": {"const": "pilot-repeat-receipt-v1"},
    "evidence_class": {"const": "ENGINEERING_FIXTURE_ONLY"},
    "study_class": {"const": "BUDGET_CONSTRAINED_EXPLORATORY_PILOT"},
    "run_id": {"type": "string", "enum": ["PILOT-01", "PILOT-02", "PILOT-03"]},
    "setting_id": {"const": "cd_airtravel"},
    "corpus_id": {"const": "text2uml_airtravel_253b26dc"},
    "model": {"const": "gpt-5.6-luna"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "code_sha256": {"$ref": "#/$defs/hash"},
    "case_input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "prospective_binding_sha256": {"$ref": "#/$defs/hash"},
    "event_log_sha256": {"$ref": "#/$defs/hash"},
    "lifecycle_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "termination_reason", "events", "failed_events"],
      "properties": {
        "complete": {"type": "boolean"},
        "termination_reason": {"type": "string"},
        "events": {"type": "integer", "minimum": 0},
        "failed_events": {"type": "integer", "minimum": 0}
      }
    },
    "status": {
      "type": "string",
      "enum": ["TECHNICAL_SUCCESS", "TECHNICAL_FAILURE", "STOPPED_AT_CALL_CAP", "TRUNCATION_AFFECTED"]
    },
    "failure_code": {"type": ["string", "null"]},
    "calls": {"type": "integer", "minimum": 0, "maximum": 90},
    "successful_calls": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "repeat_retry_count": {"const": 0},
    "truncated_calls": {"type": "integer", "minimum": 0},
    "scientific_denominator_eligible": {"type": "boolean"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "provider_calls": {"const": 0},
    "external_calls": {"const": 0},
    "privacy_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_content_persisted", "provider_calls"],
      "properties": {
        "raw_content_persisted": {"const": 0},
        "provider_calls": {"const": 0}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
