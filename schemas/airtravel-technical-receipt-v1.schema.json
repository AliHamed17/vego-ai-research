{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successful local fake AirTravel receipt for descriptive rendering",
  "type": "object",
  "required": ["schema_version", "status", "setting_id", "corpus_id", "N", "commit", "model", "provider", "runtime_archive_sha256", "runtime_file_hashes", "event_log_sha256", "direct_fake_call_count", "baseline_fake_call_count", "instrumented_fake_call_count", "timeout_seconds", "elapsed_seconds", "timeout", "technical_exception", "prompt_parity", "answer_parity", "decision_parity", "state_parity", "output_parity", "call_label_parity", "phase_case_count_parity", "termination_parity", "lifecycle_status", "call_inventory_status", "filesystem_containment", "external_provider_call_count", "provider_backed_production_route_pair_count", "detector_v1_experimental_run_count", "network_attempt_count", "event_count", "question_count", "orchestrator_completed", "expected_outputs_exist", "event_recorder_completed", "processed_case_ids", "files"],
  "properties": {
    "schema_version": {"const": "airtravel-technical-receipt-v1"},
    "status": {"const": "TECHNICAL_SUCCESS"},
    "setting_id": {"const": "cd_airtravel"},
    "corpus_id": {"const": "text2uml_airtravel_253b26dc"},
    "N": {"type": "integer", "const": 4},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "model": {"const": "LOCAL_DETERMINISTIC_FAKE_V3"},
    "provider": {"const": "LOCAL_ONLY"},
    "runtime_archive_sha256": {"$ref": "#/$defs/hash"},
    "runtime_file_hashes": {"type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "event_log_sha256": {"$ref": "#/$defs/hash"},
    "direct_fake_call_count": {"type": "integer", "minimum": 16, "maximum": 326},
    "baseline_fake_call_count": {"type": "integer", "minimum": 16, "maximum": 326},
    "instrumented_fake_call_count": {"type": "integer", "minimum": 16, "maximum": 326},
    "timeout_seconds": {"type": "integer", "const": 1800},
    "elapsed_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
    "timeout": {"type": "boolean", "const": false},
    "technical_exception": {"type": "null"},
    "prompt_parity": {"type": "boolean", "const": true},
    "answer_parity": {"type": "boolean", "const": true},
    "decision_parity": {"type": "boolean", "const": true},
    "state_parity": {"type": "boolean", "const": true},
    "output_parity": {"type": "boolean", "const": true},
    "call_label_parity": {"type": "boolean", "const": true},
    "phase_case_count_parity": {"type": "boolean", "const": true},
    "termination_parity": {"type": "boolean", "const": true},
    "lifecycle_status": {"const": "PASS"},
    "call_inventory_status": {"const": "PASS"},
    "filesystem_containment": {"const": "PASS"},
    "external_provider_call_count": {"type": "integer", "const": 0},
    "provider_backed_production_route_pair_count": {"type": "integer", "const": 0},
    "detector_v1_experimental_run_count": {"type": "integer", "const": 0},
    "network_attempt_count": {"type": "integer", "const": 0},
    "event_count": {"type": "integer", "minimum": 0},
    "question_count": {"type": "integer", "minimum": 0},
    "orchestrator_completed": {"type": "boolean", "const": true},
    "expected_outputs_exist": {"type": "boolean", "const": true},
    "event_recorder_completed": {"type": "boolean", "const": true},
    "processed_case_ids": {"const": ["01", "02", "03", "04"]},
    "files": {"type": "object", "minProperties": 20, "additionalProperties": {"$ref": "#/$defs/hash"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
