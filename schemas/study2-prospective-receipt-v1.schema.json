{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai.local/schemas/study2-prospective-receipt-v1.schema.json",
  "title": "Study 2 prospective run receipt (private root; redacted copy is the public aggregate)",
  "type": "object",
  "required": [
    "schema_version", "study_id", "run_id", "mode", "fake_mode", "evidence_class", "scientific_result_status",
    "execution_git_sha", "expected_head", "working_tree_clean", "manifest_path", "manifest_sha256",
    "case_selection_sha256", "budget_reservation_sha256", "command_fingerprint", "environment", "model", "caps",
    "budget", "egress", "credential_source", "case_ids", "corpus_hashes", "started_at", "completed_at", "gates",
    "conditions", "lifecycle_summary", "event_log_sha256", "pipeline_output_manifest_sha256", "ledger_sha256",
    "output_root_template", "claim_boundary", "receipt_binding"
  ],
  "properties": {
    "schema_version": {"const": "study2-prospective-receipt-v1"},
    "study_id": {"const": "VEGO-AI-STUDY-2-PROSPECTIVE"},
    "run_id": {"type": "string", "pattern": "^S2P-(LIVE|PREFLIGHT)-[0-9TZ]+$"},
    "mode": {"enum": ["LIVE", "PREFLIGHT_FAKE_PROVIDER"]},
    "fake_mode": {"type": ["string", "null"]},
    "evidence_class": {"enum": ["PROSPECTIVE EMPIRICAL EVIDENCE", "ENGINEERING-ONLY FIXTURE"]},
    "scientific_result_status": {"enum": ["EXECUTED", "NOT_EXECUTED_FIXTURE"]},
    "execution_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_head": {"type": ["string", "null"]},
    "working_tree_clean": {"type": "boolean"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "case_selection_sha256": {"$ref": "#/$defs/sha256"},
    "budget_reservation_sha256": {"$ref": "#/$defs/sha256"},
    "command_fingerprint": {"type": "object", "required": ["argv_public", "argv_sha256", "entrypoint_sha256", "package_sha256"]},
    "model": {
      "type": "object",
      "required": ["provider", "model", "api_mode", "request_parameters", "allowed_hosts"],
      "properties": {"provider": {"const": "openai"}, "model": {"const": "gpt-5.6-luna"}}
    },
    "budget": {
      "type": "object",
      "required": ["requests", "requests_by_condition", "total_request_cap", "condition_request_caps", "prompt_tokens", "completion_tokens", "actual_cost_usd", "per_request_reserve_usd", "guard_ceiling_usd", "hard_ceiling_usd", "within_hard_ceiling", "refusals"],
      "properties": {"within_hard_ceiling": {"const": true}, "hard_ceiling_usd": {"const": 6.0}}
    },
    "egress": {"type": "object", "required": ["allowed_hosts", "blocked_attempts"]},
    "credential_source": {"type": "string", "not": {"pattern": "sk-"}},
    "case_ids": {"type": "array", "minItems": 4, "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
    "gates": {"type": "object", "additionalProperties": {"type": "object", "required": ["passed", "detail"]}},
    "conditions": {"type": "object", "required": ["VEGO_AI_ON", "VEGO_AI_OFF"]},
    "claim_boundary": {"type": "array", "minItems": 3},
    "output_root_template": {"type": "string", "pattern": "^\\$\\{VEGO_PRIVATE_EVIDENCE_ROOT\\}/"},
    "receipt_binding": {"type": "object", "required": ["algorithm", "sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
