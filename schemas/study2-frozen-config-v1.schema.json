{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai.local/schemas/study2-frozen-config-v1.schema.json",
  "title": "VEGO-AI Study 2 frozen ON/OFF configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "status", "run_id", "intervention", "setting_id", "corpus_id",
    "case_ids", "corpus", "model", "execution", "privacy", "output", "conditions",
    "detector_v1", "stopping_rules", "prompt_contract", "study_separation"
  ],
  "properties": {
    "schema_version": {"const": "study2-frozen-config-v1"},
    "study_id": {"const": "VEGO-AI-STUDY-2"},
    "status": {"enum": ["PREPARED_NOT_EXECUTED", "FROZEN_PENDING_REVIEW"]},
    "run_id": {"type": "string", "minLength": 1},
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "varying_factor", "on", "off"],
      "properties": {
        "type": {"const": "SYSTEM_COMPARISON"},
        "varying_factor": {"type": "string", "minLength": 1},
        "on": {"type": "string", "minLength": 1},
        "off": {"type": "string", "minLength": 1}
      }
    },
    "setting_id": {"const": "cd_airtravel"},
    "corpus_id": {"const": "text2uml_airtravel_253b26dc"},
    "case_ids": {"type": "array", "const": ["01", "02", "03", "04"]},
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "source_manifest_sha256", "files"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["case_id", "path", "bytes", "sha256", "role"],
            "properties": {
              "case_id": {"type": "string"},
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "role": {"enum": ["domain_description", "candidate_model"]}
            }
          }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "temperature", "max_output_tokens"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "run_timeout_seconds", "retries", "concurrency", "cost_ceiling_usd", "call_ceiling", "network_policy"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "run_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "cost_ceiling_usd": {"type": "number", "minimum": 0},
        "call_ceiling": {"type": "integer", "minimum": 1},
        "network_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "provider_hosts"],
          "properties": {
            "mode": {"const": "DISABLED"},
            "provider_hosts": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
          }
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_content_persisted", "secrets_fail_closed", "private_output_root"],
      "properties": {
        "raw_content_persisted": {"const": false},
        "secrets_fail_closed": {"const": true},
        "private_output_root": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "root", "persisted_artifacts"],
      "properties": {
        "schema_id": {"const": "study2-result-v1"},
        "root": {"type": "string", "minLength": 1},
        "persisted_artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conditions": {
      "type": "object", "additionalProperties": false,
      "required": ["VEGO_AI_ON", "VEGO_AI_OFF"],
      "properties": {
        "VEGO_AI_ON": {"$ref": "#/$defs/condition"},
        "VEGO_AI_OFF": {"$ref": "#/$defs/condition"}
      }
    },
    "detector_v1": {
      "type": "object", "additionalProperties": false,
      "required": ["VEGO_AI_ON", "VEGO_AI_OFF"],
      "properties": {
        "VEGO_AI_ON": {"const": "APPLICABLE"},
        "VEGO_AI_OFF": {"const": "NOT_APPLICABLE"}
      }
    },
    "stopping_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prompt_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["on_template_id", "off_template_id", "hash_rule"],
      "properties": {
        "on_template_id": {"type": "string", "minLength": 1},
        "off_template_id": {"type": "string", "minLength": 1},
        "hash_rule": {"type": "string", "minLength": 1}
      }
    },
    "study_separation": {
      "type": "object", "additionalProperties": false,
      "required": ["pooled_with_study1", "note"],
      "properties": {
        "pooled_with_study1": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_decomposition", "inter_agent_qa", "round_loop", "detector_v1"],
      "properties": {
        "agent_decomposition": {"type": "boolean"},
        "inter_agent_qa": {"type": "boolean"},
        "round_loop": {"type": "boolean"},
        "detector_v1": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]}
      }
    }
  }
}
